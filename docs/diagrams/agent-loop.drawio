<mxfile host="app.diagrams.net" type="device"><diagram id="xiaohe-agent-loop" name="小和 Agent 主循环（2.8）"><mxGraphModel dx="1400" dy="820" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="L1" value="01 / 用户层  User" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=#FAFAFA;strokeColor=#E1E4E8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=5;fontSize=10;fontColor=#98A0AA;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1320" height="100" as="geometry"/></mxCell><mxCell id="L0" value="00 / 本地分流  Rules first（不调用模型）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=#FAFAFA;strokeColor=#E1E4E8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=5;fontSize=10;fontColor=#98A0AA;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="175" width="1320" height="80" as="geometry"/></mxCell><mxCell id="L2" value="02 / Agent Runtime 主循环" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=#FAFAFA;strokeColor=#E1E4E8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=5;fontSize=10;fontColor=#98A0AA;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="1320" height="175" as="geometry"/></mxCell><mxCell id="L3" value="03 / 工具层  Tool Layer" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=#FAFAFA;strokeColor=#E1E4E8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=5;fontSize=10;fontColor=#98A0AA;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1320" height="175" as="geometry"/></mxCell><mxCell id="L4" value="04 / 旁路  Side Branches" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=6 6;fillColor=#FAFAFA;strokeColor=#E1E4E8;align=left;verticalAlign=top;spacingLeft=12;spacingTop=5;fontSize=10;fontColor=#98A0AA;arcSize=2;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1320" height="110" as="geometry"/></mxCell><mxCell id="T1" value="输入 Intake" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2E9E6B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="36" width="120" height="16" as="geometry"/></mxCell><mxCell id="T2" value="推理 Reason" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#2E7BE0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="36" width="120" height="16" as="geometry"/></mxCell><mxCell id="T3" value="行动与观察 Act · Stop" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#E08A2E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="36" width="200" height="16" as="geometry"/></mxCell><mxCell id="in" value="&lt;div style=&quot;text-align:left&quot;&gt;💬 &lt;b&gt;用户输入&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;语音：连续收听（VAD 断句 + 唤醒词）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;文字：对话面板&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#FFFFFF;strokeColor=#B9C0CB;" vertex="1" parent="1"><mxGeometry x="60" y="88" width="210" height="56" as="geometry"/></mxCell><mxCell id="out" value="&lt;div style=&quot;text-align:left&quot;&gt;☰ &lt;b&gt;流式输出&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;像素气泡逐字显示&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;欣然逐句朗读&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#E9F7F9;strokeColor=#66C3CE;" vertex="1" parent="1"><mxGeometry x="560" y="88" width="170" height="56" as="geometry"/></mxCell><mxCell id="cancel" value="&lt;div style=&quot;text-align:left&quot;&gt;✋ &lt;b&gt;用户中断&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;停止按钮 · 说「小和」打断播报&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#FFFFFF;strokeColor=#B9C0CB;" vertex="1" parent="1"><mxGeometry x="870" y="88" width="200" height="56" as="geometry"/></mxCell><mxCell id="resp" value="&lt;div style=&quot;text-align:left&quot;&gt;⏎ &lt;b&gt;返回响应&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;气泡 · 朗读 · 页面动作&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#E9F7F9;strokeColor=#66C3CE;" vertex="1" parent="1"><mxGeometry x="1170" y="88" width="170" height="56" as="geometry"/></mxCell><mxCell id="rules" value="&lt;div style=&quot;text-align:left&quot;&gt;⚑ &lt;b&gt;本地分流 decide()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;唤醒 · 找书 · 阅读指令 · 记住 · 选书&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#EAF1FC;strokeColor=#7BA3E0;" vertex="1" parent="1"><mxGeometry x="290" y="205" width="230" height="48" as="geometry"/></mxCell><mxCell id="direct" value="&lt;div style=&quot;text-align:left&quot;&gt;▶ &lt;b&gt;直接执行&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;状态机取书、翻页、记住&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;即时、免费&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#EAF1FC;strokeColor=#7BA3E0;" vertex="1" parent="1"><mxGeometry x="60" y="205" width="190" height="48" as="geometry"/></mxCell><mxCell id="memory" value="&lt;div style=&quot;text-align:left&quot;&gt;{} &lt;b&gt;记忆召回&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;事实 · 推测 · 印象 · 摘要&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;按相关度取用，≤ 520 字&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#EEE8FA;strokeColor=#A78BE0;" vertex="1" parent="1"><mxGeometry x="60" y="300" width="200" height="56" as="geometry"/></mxCell><mxCell id="rag" value="&lt;div style=&quot;text-align:left&quot;&gt;❡ &lt;b&gt;原文检索 · 眼前这一页&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;FTS5 + 句向量 RRF，防剧透&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;追问带上上一句；问「这段」附本页&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#EEE8FA;strokeColor=#A78BE0;" vertex="1" parent="1"><mxGeometry x="60" y="368" width="200" height="64" as="geometry"/></mxCell><mxCell id="build" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;构建上下文 Build Context&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;人格 system · 前情摘要&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;最近 3–6 轮原文&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;工具清单：按状态每轮重算&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;tools/llm_chat.py&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#E4F4EA;strokeColor=#74BE97;" vertex="1" parent="1"><mxGeometry x="300" y="300" width="210" height="90" as="geometry"/></mxCell><mxCell id="llm" value="&lt;div style=&quot;text-align:left&quot;&gt;✦ &lt;b&gt;LLM 调用&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;流式 Chat Completions&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;可配置的模型服务&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#FDF2DF;strokeColor=#E3B471;" vertex="1" parent="1"><mxGeometry x="560" y="305" width="170" height="66" as="geometry"/></mxCell><mxCell id="routeout" value="&lt;div style=&quot;text-align:left&quot;&gt;⇄ &lt;b&gt;输出判定&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;有没有 tool_calls?&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#E4F4EE;strokeColor=#6FBFB0;" vertex="1" parent="1"><mxGeometry x="770" y="305" width="150" height="66" as="geometry"/></mxCell><mxCell id="stop" value="&lt;div style=&quot;text-align:left&quot;&gt;⏹ &lt;b&gt;停止条件 Stop Check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;完成 · 联网至多 2 轮（末轮强制作答）&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;每轮界面动作 ≤ 3 · 60 秒超时&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;回复超长 · 出错&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#FCEAEE;strokeColor=#E0808F;" vertex="1" parent="1"><mxGeometry x="970" y="295" width="230" height="86" as="geometry"/></mxCell><mxCell id="policy" value="&lt;div style=&quot;text-align:left&quot;&gt;⚿ &lt;b&gt;政策审批 Policy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;按状态的白名单&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;参数逐项核对 · 次数上限&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;tools/app_actions.py&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#FCEAEE;strokeColor=#E0808F;" vertex="1" parent="1"><mxGeometry x="560" y="490" width="170" height="66" as="geometry"/></mxCell><mxCell id="server" value="&lt;div style=&quot;text-align:left&quot;&gt;⚙ &lt;b&gt;服务端执行&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;查书 · 书签 · 推荐&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;联网搜索 / 抓取&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#FDF2DF;strokeColor=#E3B471;" vertex="1" parent="1"><mxGeometry x="780" y="480" width="170" height="58" as="geometry"/></mxCell><mxCell id="page" value="&lt;div style=&quot;text-align:left&quot;&gt;⚙ &lt;b&gt;页面执行（动作事件）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;天空 · 取书 · 翻章 · 音乐 · 定位 · 字号&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;页面再核对；取书后的翻章等书到手&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#FDF2DF;strokeColor=#E3B471;" vertex="1" parent="1"><mxGeometry x="780" y="550" width="240" height="70" as="geometry"/></mxCell><mxCell id="append" value="&lt;div style=&quot;text-align:left&quot;&gt;＋ &lt;b&gt;追加结果 Append&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;工具结果 / 拒绝原因&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;回给模型&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#E6F7EE;strokeColor=#68C08C;" vertex="1" parent="1"><mxGeometry x="1070" y="485" width="160" height="62" as="geometry"/></mxCell><mxCell id="consent" value="&lt;div style=&quot;text-align:left&quot;&gt;✔ &lt;b&gt;读者确认（循环外）&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;下载：说「要」才下载&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;30 秒内有效&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#FCEAEE;strokeColor=#E0808F;" vertex="1" parent="1"><mxGeometry x="1070" y="560" width="160" height="62" as="geometry"/></mxCell><mxCell id="compact" value="&lt;div style=&quot;text-align:left&quot;&gt;⇩ &lt;b&gt;上下文压缩 Compaction&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;超 6 轮 / 24000 字时&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;较早几轮 → 前情摘要（/chat/compact）&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#E6F6F2;strokeColor=#6FC0A8;" vertex="1" parent="1"><mxGeometry x="300" y="680" width="240" height="62" as="geometry"/></mxCell><mxCell id="consolidate" value="&lt;div style=&quot;text-align:left&quot;&gt;✎ &lt;b&gt;记忆整理&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;对话安静 3 分钟后，同一次调用写：&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;摘要 · 重要度 · 推测 · 读者印象&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#E6F6F2;strokeColor=#6FC0A8;" vertex="1" parent="1"><mxGeometry x="600" y="680" width="250" height="62" as="geometry"/></mxCell><mxCell id="sub" value="&lt;div style=&quot;text-align:left&quot;&gt;✧ &lt;b&gt;子智能体 Subagent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;未采用：每轮至多 3 个小工具，&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:8px;color:#5F6B7A&quot;&gt;且多有先后，无需另开循环&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=4;fontSize=10;arcSize=14;fillColor=#F5F5F5;strokeColor=#C8C8C8;