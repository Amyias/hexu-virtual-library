    { "id": "title-06", "category": "书名", "say": ["小和，我想看百年孤独"], "expect": { "wake": true, "type": "present", "book": "百年孤独" } },
    { "id": "title-07", "category": "书名", "say": ["小和，帮我找平凡的世界"], "expect": { "wake": true, "type": "present", "book": "平凡的世界" } },
    { "id": "title-08", "category": "书名", "say": ["小和，帮我找 Pride and Prejudice"], "expect": { "wake": true, "type": "present", "book": "Pride and Prejudice" } },
    { "id": "title-09", "category": "书名", "say": ["小和，我想读围城"], "expect": { "wake": true, "type": "present", "book": "围城" } },
