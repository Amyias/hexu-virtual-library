    { "id": "title-03", "category": "书名", "say": ["小和，我要找狂人日记"], "expect": { "wake": true, "type": "present", "book": "狂人日记" } },
    { "id": "title-04", "category": "书名", "say": ["小和，找一本活着"], "expect": { "wake": true, "type": "present", "book": "活着" } },
