    { "id": "step-05", "category": "两步找书", "say": ["小和", "我想看时间简史"], "expect": { "wake": true, "type": "present", "book": "时间简史" } },

    { "id": "title-01", "category": "书名", "say": ["小和，帮我找三体"], "expect": { "wake": true, "type": "present", "book": "三体" } },
