    { "id": "wake-03", "category": "唤醒", "say": ["小和小和"], "expect": { "wake": true, "type": "wake-only" } },
    { "id": "wake-04", "category": "唤醒", "say": ["嘿，小和"], "expect": { "wake": true, "type": "wake-only" } },
    { "id": "wake-05", "category": "唤醒", "say": ["小和，你在吗"], "expect": { "wake": true, "type": "wake-only" } },
