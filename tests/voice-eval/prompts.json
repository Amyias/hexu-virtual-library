    { "id": "chat-06", "category": "对话", "say": ["小和，红楼梦的作者是谁"], "expect": { "wake": true, "type": "chat" } },

    { "id": "read-01", "category": "阅读指令", "phase": "READING", "say": ["小和，下一页"], "expect": { "wake": true, "type": "reading", "command": "next" } },
